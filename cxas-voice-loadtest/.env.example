# ---- Target agent (required) ----
CXAS_PROJECT=my-gcp-project
CXAS_LOCATION=us                       # region of the CXAS app
CXAS_APP=my-app-id                     # app id (projects/.../apps/<this>)
# CXAS_DEPLOYMENT=my-deployment-id     # optional: pin a deployment (short id or full name)
# CXAS_ENTRY_AGENT=                    # optional entry agent
# CXAS_TIME_ZONE=America/New_York
# CXAS_USE_TOOL_FAKES=false            # true = use tool fakes (isolate CXAS from backends)

# ---- Endpoint / auth ----
# Auth = Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS or gcloud ADC)
CXAS_API_ENDPOINT=ces.googleapis.com   # use the regional endpoint if your app requires one
# CXAS_QUOTA_PROJECT=
# CXAS_CHANNELS_PER_PROCESS=1          # >1 if a worker runs >80 concurrent calls

# ---- Audio (telephony defaults) ----
CXAS_INPUT_ENCODING=MULAW              # MULAW | ALAW | LINEAR16
CXAS_INPUT_SAMPLE_RATE=8000
CXAS_OUTPUT_ENCODING=MULAW
CXAS_OUTPUT_SAMPLE_RATE=8000
CXAS_CHUNK_MS=60                       # API recommends 40-120 ms
CXAS_AUDIO_DIR=audio
CXAS_SCENARIOS=scenarios/example.yaml

# ---- Conversation behaviour ----
CXAS_EXPECT_GREETING=true
CXAS_LISTEN_TO_AGENT_AUDIO=true
CXAS_DEFAULT_PAUSE_MS=600
CXAS_TURN_TIMEOUT_S=30
CXAS_CALL_GAP_MIN_S=1
CXAS_CALL_GAP_MAX_S=3

# ---- Load shape / quota ----
# CXAS_STEPS=5:300,10:300,15:600       # users:seconds[:spawn_rate], overrides -u/-r/-t
CXAS_QUOTA_CONCURRENT_STREAMS=15       # only used to warn when -u exceeds it
CXAS_BACKOFF_INITIAL_S=2
CXAS_BACKOFF_MAX_S=60
# CXAS_STOP_AFTER_QUOTA_ERRORS=50
# CXAS_MAX_SESSIONS_PER_PROCESS=0

# ---- Output ----
CXAS_RESULTS_JSONL=results/turns.jsonl
CXAS_LOG_TRANSCRIPTS=false
CXAS_PER_TURN_STATS=false
